---
import '../styles/global.css';
---

<body>
  <section class="container">
    <div class="section_content">
      <h2 class="section_title">key highlights</h2>
      <div class="section_col">
        <div class="col">
          <h3 class="col_title">Gameplay</h3>
          <ul class="col_description">
            <!-- <li class="col_description_element"></li> -->
            <li>Improved the cover system decreasing level loading time</li>
            <li>Improved player movement system</li>
            <li>
              Implemented gamepads supportand vendor specific features for
              Sony,Xbox, Steam, and Nintendo controllers.
            </li>
          </ul>
        </div>
        <div class="col">
          <h3 class="col_title">Rendering & UI</h3>
          <ul class="col_description">
            <!-- <li class="col_description_element"></li> -->
            <li>Improved the cover system decreasing level loading time</li>
            <li>Improved player movement system</li>
            <li>
              Implemented gamepads supportand vendor specific features for
              Sony,Xbox, Steam, and Nintendo controllers.
            </li>
          </ul>
        </div>
        <div class="col">
          <h3 class="col_title">Networking</h3>
          <ul class="col_description">
            <!-- <li class="col_description_element"></li> -->
            <li>Improved the cover system decreasing level loading time</li>
            <li>Improved player movement system</li>
            <li>
              Implemented gamepads supportand vendor specific features for
              Sony,Xbox, Steam, and Nintendo controllers.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</body>

<style scoped>
  body {
    background: #181a1b;
  }

  .container {
    font-family: var(--article-font-family);
    display: flex;
    justify-content: space-between;
    flex-direction: row;
    width: 1440px;
    max-width: 100%;
    margin: 0 auto;
    padding: 100px 110px;
  }

  .section_content {
    display: flex;
    flex-direction: row;
    gap: 75px;
  }

  .section_title {
    display: block;
    color: var(--v2-secondary);
    align-self: start;
    font-size: 50px;
    line-height: 60px;
  }

  .section_col {
    display: flex;
    flex-direction: row;
    gap: 80px;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 260px;
  }

  .col_title {
    font-size: 30px;
    font-weight: 500;
    color: #ffffff;
  }

  .col_description {
    padding: 0;
  }

  .col_description li {
    position: relative;
    font-size: 15px;
    line-height: 28px;
    letter-spacing: normal;
    font-weight: 400;
    padding-left: 25px;
    color: #ffffff;
    list-style: none;
  }

  .col_description li::before {
    content: '';
    display: block;
    position: absolute;
    top: 12px;
    left: 10px;
    width: 4px;
    height: 4px;
    background: #ffffff;
    border-radius: 50%;
  }

  /* ─── TABLET (≤1599px) ───────────────────────────── */

  @media only screen and (max-width: 1599px) {
    .container {
      padding: 80px 80px;
    }

    .section_content {
      gap: 50px;
    }

    .section_col {
      gap: 50px;
    }

    .col {
      width: 220px;
    }

    .section_title {
      font-size: 40px;
      line-height: 50px;
    }
  }

  /* ─── MOBILE (≤768px) ────────────────────────────── */

  @media only screen and (max-width: 768px) {
    .container {
      padding: 48px 24px;
    }

    .section_content {
      flex-direction: column;
      gap: 32px;
      width: 100%;
    }

    .section_title {
      font-size: 32px;
      line-height: 1.2;
    }

    .section_col {
      flex-direction: column;
      gap: 32px;
      width: 100%;
    }

    .col {
      width: 100%;
    }

    .col_title {
      font-size: 22px;
    }

    .col_description li {
      font-size: 15px;
      line-height: 26px;
    }
  }

  /* ─── SMALL MOBILE (≤390px) ──────────────────────── */

  @media only screen and (max-width: 390px) {
    .container {
      padding: 40px 18px;
    }

    .section_title {
      font-size: 28px;
    }

    .col_title {
      font-size: 20px;
    }

    .col_description li {
      font-size: 14px;
    }
  }
</style>
