---
import '../styles/global.css';
import myPlus from '/plus_icon.png';
import myCheck from '/check_icon.png';
import { mergeProps } from 'vue';
import type { Project } from '../content.config';

type Props = Project['short-textblock'] & {};

const { title, summary } = Astro.props;
---

<div class="section_content">
  <h2 class="section_title">
    <span>{title.highlightTitle}</span>
    {title.secondPartTitle}
  </h2>
  <p class="section_summary">
    {summary}
  </p>
</div>

<style scoped>
  .section_title {
    font-size: 45px;
    font-weight: bold;
    line-height: 60px;
    margin: 0;
  }

  .section_title span {
    color: rgba(var(--layer-color), 1);
  }

  .section_content {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section_summary {
    font-size: 22px;
    font-weight: 400;
    line-height: 40px;
    margin: 0;
  }

  /* ─── TABLET (≤1599px) ───────────────────────────── */

  @media only screen and (max-width: 1599px) {
    .section_title {
      font-size: 38px;
      line-height: 50px;
    }

    .section_summary {
      font-size: 19px;
      line-height: 36px;
    }
  }

  /* ─── MOBILE (≤768px) ────────────────────────────── */

  @media only screen and (max-width: 768px) {
    .section_title {
      font-size: 26px;
      line-height: 1.3;
    }

    .section_summary {
      font-size: 15px;
      line-height: 28px;
    }

    .section_content {
      gap: 8px;
    }
  }

  /* ─── SMALL MOBILE (≤390px) ──────────────────────── */

  @media only screen and (max-width: 390px) {
    .section_title {
      font-size: 22px;
    }

    .section_summary {
      font-size: 15px;
      line-height: 26px;
    }
  }
</style>
