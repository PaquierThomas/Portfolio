---
import '../styles/global.css';
import myPlus from '/plus_icon.png';
import myCheck from '/check_icon.png';
import { mergeProps } from 'vue';
import type { Project } from '../content.config';

type Props = Project['textblock'] & {};

const { title, summary, paragraph } = Astro.props;
---

<div class="section_content">
  <h2 class="section_title">
    <span>{title.highlightTitle}</span>
    {title.secondPartTitle}
  </h2>
  <p class="section_summary">
    {summary}
  </p>
  <div class="section_description">
    {paragraph?.map((text: string) => <p>{text}</p>)}
  </div>
</div>

<style scoped>
  .section_title {
    font-size: 50px;
    font-weight: bold;
    line-height: 60px;
    margin: 0;
  }

  .section_title span {
    color: #44e9ff;
  }

  .section_content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .section_summary {
    font-size: 30px;
    font-weight: 400;
    line-height: 40px;
    margin: 0;
  }

  .section_description {
    display: grid;
    grid-column-gap: 60px;
    grid-row-gap: 30px;
    font-size: 15px;
    font-weight: 400;
    line-height: 28px;
  }

  /* ─── TABLET (≤1599px) ───────────────────────────── */

  @media only screen and (max-width: 1599px) {
    .section_title {
      font-size: 42px;
      line-height: 52px;
    }

    .section_summary {
      font-size: 26px;
      line-height: 36px;
    }
  }

  /* ─── MOBILE (≤768px) ────────────────────────────── */

  @media only screen and (max-width: 768px) {
    .section_content {
      gap: 24px;
    }

    .section_title {
      font-size: 28px;
      line-height: 1.3;
    }

    .section_summary {
      font-size: 18px;
      line-height: 30px;
    }

    /* Force single column on mobile regardless of JS calc */
    .section_description {
      grid-template-columns: 1fr !important;
      grid-column-gap: 0;
      grid-row-gap: 20px;
      font-size: 15px;
      line-height: 26px;
    }
  }

  /* ─── SMALL MOBILE (≤390px) ──────────────────────── */

  @media only screen and (max-width: 390px) {
    .section_title {
      font-size: 24px;
    }

    .section_summary {
      font-size: 15px;
      line-height: 28px;
    }

    .section_description {
      font-size: 14px;
      line-height: 24px;
    }
  }
</style>

<script>
  const section_description = document.querySelector(
    '.section_description'
  ) as HTMLDivElement;

  const paragraphs = section_description.children;

  let column = 2;
  if (paragraphs.length === 1) {
    column = 1;
  } else if (paragraphs.length % 2 !== 0 || paragraphs.length === 6) {
    column = 3;
  }

  section_description.style.gridTemplateColumns = `repeat(${column}, 1fr)`;
</script>
