---
import '../styles/global.css';
import type { Project } from '../content.config';
import ArticleTextBlock from '../components/article-text-block.astro';
import ArticleProsCons from '../components/article-pros-cons.astro';
import ArticleSectionTitle from '../components/article-section-title.astro';
import ArticleImage from '../components/article-image.astro';
import ArticleVideo from '../components/article-video.astro';
import ArticleAboutProject from '../components/article-about-project.astro';

type Props = Project & {};

const { Content, ...props } = Astro.props;
---

<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{props.title} {props.title2} - Thomas Paquier</title>
  </head>
  <body>
    <button id="theme-switch">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 -960 960 960"
        fill="#e8eaed"
      >
        <path
          d="M480-280q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Z"
        ></path>
      </svg>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 -960 960 960"
        fill="#e8eaed"
      >
        <path
          d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Z"
        ></path>
      </svg>
    </button>

    <main class="main">
      <div class="nav">
        <div class="nav-content">
          <div class="top-left">
            <a href="/">
              <h3>THOMAS</h3>
              <h3>PAQUIER</h3>
            </a>
          </div>
          <div class="top-right">
            <a href="#">Drawing</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
      </div>

      <section class="article">
        <div class="wrapper-titre">
          <div class="titles">
            <h2 class="first">{props.title} <br /> {props.title2}</h2>
          </div>
        </div>
      </section>

      <section class="container">
        <div class="back-row">
          <a href="/projects" class="back-link">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 32 16"
              width="32"
              height="16"
            >
              <line
                x1="32"
                y1="8"
                x2="0"
                y2="8"
                stroke="currentColor"
                stroke-width="1.5"></line>
              <polyline
                points="8,1 0,8 8,15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
                stroke-linecap="round"></polyline>
            </svg>
            Back to projects
          </a>
        </div>

        <ArticleAboutProject
          subject={props.subject}
          summary={props.summary}
          client={props.client}
          annee={props.annee}
          roles={props.roles}
        />

        <div class="section_content">
          <slot />
          {
            props.sectionTitle && (
              <ArticleSectionTitle {...props.sectionTitle} />
            )
          }
          {
            props.videos &&
              props.videos.map((video, index) => (
                <ArticleVideo key={index} {...video} />
              ))
          }
          {
            props.images &&
              props.images.map((image, index) => (
                <ArticleImage key={index} {...image} />
              ))
          }
          {props.textblock && <ArticleTextBlock {...props.textblock} />}
          {props.procons && <ArticleProsCons procons={props.procons} />}
        </div>
      </section>

      <script type="text/javascript" defer>
        document.addEventListener('DOMContentLoaded', () => {
          const nav = document.querySelector('.nav');
          const SCROLL_THRESHOLD = 1100;

          const updateNav = () => {
            const isDarkMode = document.body.classList.contains('darkmode');
            if (!isDarkMode) {
              if (window.scrollY < SCROLL_THRESHOLD) {
                nav.classList.add('nav--top');
              } else {
                nav.classList.remove('nav--top');
              }
            } else {
              nav.classList.remove('nav--top');
            }
          };

          window.addEventListener('scroll', updateNav, { passive: true });
          updateNav();

          const themeSwitch = document.getElementById('theme-switch');
          let darkmode = localStorage.getItem('darkmode');

          const enableDarkMode = () => {
            document.body.classList.add('darkmode');
            localStorage.setItem('darkmode', 'active');
            updateNav();
          };

          const disableDarkMode = () => {
            document.body.classList.remove('darkmode');
            localStorage.removeItem('darkmode');
            updateNav();
          };

          if (darkmode === 'active') enableDarkMode();

          themeSwitch.addEventListener('click', () => {
            darkmode = localStorage.getItem('darkmode');
            darkmode !== 'active' ? enableDarkMode() : disableDarkMode();
          });
        });
      </script>
    </main>

    <style define:vars={{ projectImage: `url(${props.imageCouverture})` }}>
      /* ─── THEME BUTTON ───────────────────────────────── */

      #theme-switch {
        display: flex;
        justify-content: center;
        align-items: center;
        position: fixed;
        bottom: 30px;
        left: 30px;
        height: 60px;
        width: 60px;
        padding: 10px;
        border: 2px solid var(--v2-secondary);
        border-radius: 50%;
        background-color: var(--v2-primary);
        cursor: pointer;
        z-index: 1000;
      }

      #theme-switch svg {
        fill: var(--v2-secondary);
        transition: transform 0.3s;
      }

      #theme-switch:hover svg {
        fill: var(--v2-primary-hover);
        filter: drop-shadow(0 0 20px var(--v2-primary-hover));
      }

      #theme-switch svg:last-child {
        display: none;
      }

      .darkmode #theme-switch svg:first-child {
        display: none;
      }

      .darkmode #theme-switch svg:last-child {
        display: block;
      }

      /* ─── BASE ───────────────────────────────────────── */

      body {
        background: var(--v2-primary);
        margin: 0;
      }

      /* ─── NAV ─────────────────────────────────────────── */

      .nav--top .nav-content,
      .nav--top .nav-content a {
        color: #ffffff;
      }

      .nav--top .nav-content a:hover {
        color: var(--v2-primary-hover);
        filter: drop-shadow(0 0 20px var(--v2-primary-hover));
      }

      .nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: auto;
        padding: 120px 160px;
        background-color: transparent;
        z-index: 100;
        pointer-events: none;
        box-sizing: border-box;
      }

      .nav-content {
        position: relative;
        height: 100%;
        width: 100%;
        color: var(--v2-secondary);
        font-family: aktiv-grotesk, sans-serif;
        font-weight: 600;
        text-transform: uppercase;
        pointer-events: none;
      }

      .nav-content a {
        text-decoration: none;
        color: var(--v2-secondary);
        pointer-events: all;
      }

      .nav-content a,
      .nav-content a:visited {
        color: var(--v2-secondary);
      }

      .nav-content a:hover {
        color: var(--v2-primary-hover);
        filter: drop-shadow(0 0 20px var(--v2-primary-hover));
      }

      .nav-content div:first-child {
        position: absolute;
        top: 0;
        left: 0;
      }

      .nav-content div:first-child a > h3 {
        font-size: 14px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        letter-spacing: 5px;
        z-index: 100;
        margin: 0;
      }

      .nav-content div:nth-child(2) {
        position: absolute;
        top: 0;
        right: 0;
        font-size: 12px;
        letter-spacing: 1.4px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        justify-content: flex-end;
      }

      /* ─── HERO ───────────────────────────────────────── */

      .article {
        background-image: var(--projectImage);
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
        height: 99vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        position: relative;
      }

      .article::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        display: block;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.2);
        z-index: 1;
      }

      .wrapper-titre {
        font-family: aktiv-grotesk, sans-serif;
        position: relative;
        height: 60%;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .titles {
        height: 100%;
        width: 35%;
        left: 13%;
        text-transform: uppercase;
      }

      .titles h2 {
        font-family: aktiv-grotesk-extended, sans-serif;
        font-weight: 800;
        font-size: 5vw;
        color: var(--text-color);
        font-style: normal;
        letter-spacing: 0;
        position: absolute;
        line-height: 110%;
        top: 52%;
        left: 15%;
        transform: translateY(-50%);
        z-index: 5;
        margin: 0;
      }

      /* ─── CONTAINER ──────────────────────────────────── */

      .container {
        font-family: var(--article-font-family);
        display: flex;
        justify-content: space-between;
        flex-direction: column;
        color: var(--v2-secondary);
        width: 1220px;
        max-width: 100%;
        margin: 0 auto;
        padding: 100px 110px;
        box-sizing: border-box;
      }

      /* ─── BACK LINK ──────────────────────────────────── */

      .back-row {
        max-width: 960px;
        margin: 0 auto;
        width: 100%;
        padding-bottom: 2rem;
        position: relative;
        z-index: 200;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        font-family: Proximanova, sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--v2-secondary);
        opacity: 0.8;
        transition:
          opacity 0.2s,
          color 0.2s;
      }

      .back-link svg {
        fill: currentColor;
        flex-shrink: 0;
        transition: transform 0.2s;
      }

      .back-link:hover {
        opacity: 1;
        color: var(--v2-primary-hover);
      }

      .back-link:hover svg {
        transform: translateX(-3px);
      }

      /* ─── SECTION CONTENT ────────────────────────────── */

      .section_content {
        display: flex;
        flex-direction: column;
        max-width: 960px;
        margin: 0 auto;
        gap: 60px;
        z-index: 1000;
        width: 100%;
      }

      .section_content h2 {
        font-size: 32px;
      }

      /* ─── TABLET (≤1599px) ───────────────────────────── */

      @media only screen and (max-width: 1599px) {
        .nav {
          padding: 80px 80px;
        }
        .section_content {
          max-width: 900px;
        }
        .back-row {
          max-width: 900px;
        }
      }

      /* ─── MOBILE (≤768px) ────────────────────────────── */

      @media only screen and (max-width: 768px) {
        /* Theme button: bottom-right on mobile */
        #theme-switch {
          bottom: 20px;
          left: auto;
          right: 20px;
          height: 44px;
          width: 44px;
          padding: 8px;
        }

        /* Nav */
        .nav {
          padding: 28px 24px;
          height: auto;
          pointer-events: none;
        }

        .nav-content {
          position: static;
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
          pointer-events: none;
          width: 100%;
          height: auto;
        }

        .nav-content div:first-child,
        .nav-content div:nth-child(2) {
          position: static;
        }

        .nav-content div:first-child {
          pointer-events: all;
        }

        .nav-content div:first-child a > h3 {
          font-size: 11px;
          letter-spacing: 3px;
          line-height: 1.4;
        }

        .nav-content div:nth-child(2) {
          flex-direction: row;
          gap: 18px;
          font-size: 11px;
          letter-spacing: 1px;
          align-items: flex-start;
          pointer-events: all;
        }

        /* Hero */
        .article {
          height: 60vh;
          min-height: 300px;
        }

        .titles {
          width: 100%;
          left: 0;
          padding: 0 24px;
        }

        .titles h2 {
          font-size: 9vw;
          left: 24px;
          top: 50%;
          line-height: 110%;
        }

        /* Container */
        .container {
          padding: 48px 24px;
        }

        .back-row {
          max-width: 100%;
          padding-bottom: 1.5rem;
        }

        /* Section content */
        .section_content {
          max-width: 100%;
          gap: 40px;
        }

        .section_content h2 {
          font-size: 24px;
        }
      }

      /* ─── SMALL MOBILE (≤390px) ──────────────────────── */

      @media only screen and (max-width: 390px) {
        .article {
          height: 50vh;
        }

        .titles h2 {
          font-size: 11vw;
        }

        .container {
          padding: 40px 18px;
        }

        .nav-content div:first-child a > h3 {
          font-size: 10px;
          letter-spacing: 2px;
        }

        .nav-content div:nth-child(2) {
          font-size: 10px;
          gap: 14px;
        }

        .section_content {
          gap: 32px;
        }

        .section_content h2 {
          font-size: 20px;
        }
      }
    </style>
  </body>
</html>
